# LifeStream Blood Bank Management System - Environment Configuration
# Copy this to .env for local testing or set these in Render Dashboard

# Security
SECRET_KEY=django-insecure-lifestream-production-secret-key-replace-in-render
DJANGO_DEBUG=False

# Host and CSRF Configuration (Render automatically configures RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database (Leave empty for SQLite, or provide Render PostgreSQL connection string)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Initial Superuser Account (Created on first run via seed_data)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@lifestream.org
# DJANGO_SUPERUSER_PASSWORD=admin123
